# backend/.env.example

# 是否启用 DS（也可通过接口参数 llm_enabled 控制）
DS_ENABLED=false

# DeepSeek API Key（真实值不要提交到 Git）
DS_API_KEY=your_deepseek_api_key_here

# OpenAI-compatible base_url
DS_BASE_URL=https://api.deepseek.com/v1

# 模型名（按你的账号可用模型填写）
DS_MODEL=deepseek-chat

# 超时（毫秒）
DS_TIMEOUT_MS=15000

# 重试次数（失败后重试）
DS_MAX_RETRIES=1

# 温度（结构化输出建议 0）
DS_TEMPERATURE=0.0